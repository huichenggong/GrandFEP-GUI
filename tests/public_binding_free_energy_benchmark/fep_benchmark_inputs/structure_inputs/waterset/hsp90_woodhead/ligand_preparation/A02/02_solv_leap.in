source leaprc.water.tip3p
source leaprc.gaff2

MOL = loadmol2 ../00_A02_centered.mol2
loadamberparams A02.frcmod

water = loadpdb ../02_water.pdb
SYS = combine { MOL water }

setBOX SYS vdw

addIonsRand SYS Na+ 4 Cl- 4

savepdb       SYS 02_solv.pdb
saveamberparm SYS 02_solv.prmtop 02_solv.inpcrd

quit

